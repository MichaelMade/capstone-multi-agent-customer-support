# ---- Required ----
# OpenAI (or OpenAI-compatible) API key used by all agents.
OPENAI_API_KEY=sk-your-key-here

# ---- Optional (defaults shown) ----
# OpenAI-compatible chat model with tool-calling and structured-output support.
MODEL_NAME=gpt-4o-mini
# Sampling temperature. Keep at 0 to minimize hallucination.
TEMPERATURE=0.0
# Point at any OpenAI-compatible API (e.g. Azure, vLLM, Ollama gateway).
# Leave unset for api.openai.com.
OPENAI_API_BASE=
# Port for the Gradio UI.
PORT=7860
# Bind host for the Gradio server. Defaults to loopback (127.0.0.1).
# The chat has no auth layer — only bind 0.0.0.0 behind a reverse proxy
# or inside a container (the Dockerfile sets HOST=0.0.0.0 explicitly).
HOST=127.0.0.1
# Pinned SHA-256 of the Chinook SQL artifact, verified before execution.
# Set to a new hash if upstream legitimately changes, or "skip" to
# disable verification (not recommended).
# CHINOOK_SHA256=caf31d698a4a79c628215b552dfe6575e71be052ae02b8f18e763498f55f5d44
# Logging level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
# Disable Gradio usage telemetry by default. Set True to opt in.
GRADIO_ANALYTICS_ENABLED=False
# Override the Chinook SQL download URL or cache location if needed.
# CHINOOK_SQL_URL=https://raw.githubusercontent.com/lerocha/chinook-database/master/ChinookDatabase/DataSources/Chinook_Sqlite.sql
# CHINOOK_CACHE_PATH=./data/Chinook_Sqlite.sql
